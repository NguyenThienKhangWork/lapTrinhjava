        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml AlTasker_UseCase_Simple\nleft to right direction\nskinparam packageStyle rectangle\n\nskinparam actor {\n    BackgroundColor #DDEEFF\n    BorderColor #336699\n    FontStyle bold\n}\n\nskinparam usecase {\n    BackgroundColor #FFFDE7\n    BorderColor #F9A825\n    FontSize 11\n}\n\nskinparam package {\n    BackgroundColor #F5F5F5\n    BorderColor #BDBDBD\n    FontStyle bold\n    FontSize 13\n}\n\n&#39; ════════════════════════════════\n&#39;  ACTORS\n&#39; ════════════════════════════════\nactor \&quot;Guest\&quot; as Guest\nactor \&quot;Client\&quot; as Client\nactor \&quot;Expert\&quot; as Expert\nactor \&quot;Admin\&quot; as Admin\nactor \&quot;Gemini AI\&quot; as AI\nactor \&quot;Stripe\&quot; as Stripe\n\nGuest &lt;|-- Client\nGuest &lt;|-- Expert\n\n&#39; ════════════════════════════════\n&#39;  SYSTEM BOUNDARY\n&#39; ════════════════════════════════\nrectangle \&quot;AlTasker System\&quot; &lt;&lt;subsystem&gt;&gt; {\n    usecase \&quot;Register Account\&quot; as UC_REGISTER\n    usecase \&quot;Login / Logout\&quot; as UC_LOGIN\n    usecase \&quot;Post Job\&quot; as UC_POST_JOB\n    usecase \&quot;Browse Marketplace\&quot; as UC_BROWSE\n    usecase \&quot;Submit Proposal\&quot; as UC_PROPOSAL\n    usecase \&quot;Manage Project\&quot; as UC_PROJECT\n    usecase \&quot;Fund &amp; Release Escrow\&quot; as UC_PAYMENT\n    usecase \&quot;Write Review\&quot; as UC_REVIEW\n    usecase \&quot;Real-time Chat\&quot; as UC_CHAT\n    usecase \&quot;AI Assistant\&quot; as UC_AI\n    usecase \&quot;Admin Dashboard\&quot; as UC_ADMIN\n    usecase \&quot;Resolve Dispute\&quot; as UC_DISPUTE\n}\n\n&#39; ════════════════════════════════\n&#39;  ACTOR → USE CASE\n&#39; ════════════════════════════════\n\n&#39; Guest\nGuest --&gt; UC_REGISTER\nGuest --&gt; UC_LOGIN\nGuest --&gt; UC_BROWSE\n\n&#39; Client\nClient --&gt; UC_POST_JOB\nClient --&gt; UC_PROJECT\nClient --&gt; UC_PAYMENT\nClient --&gt; UC_REVIEW\nClient --&gt; UC_CHAT\nClient --&gt; UC_AI\n\n&#39; Expert\nExpert --&gt; UC_PROPOSAL\nExpert --&gt; UC_PROJECT\nExpert --&gt; UC_REVIEW\nExpert --&gt; UC_CHAT\nExpert --&gt; UC_AI\n\n&#39; Admin\nAdmin --&gt; UC_ADMIN\nAdmin --&gt; UC_DISPUTE\n\n&#39; Gemini AI (tác nhân bên ngoài cung cấp dịch vụ)\nAI --&gt; UC_AI\n\n&#39; Stripe (xử lý thanh toán webhook)\nStripe --&gt; UC_PAYMENT\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jwdoeD3d9rnqP8ifS9CP-942">
