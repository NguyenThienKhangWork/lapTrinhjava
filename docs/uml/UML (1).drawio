        <mxCell id="lCrRU7iMGGIK8T2wCj79-103" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;font: 700 20px / 30px quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(249, 250, 251); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(21, 21, 23); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;AI Job Assistant Flow&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="220" width="757.5" x="2252.5" y="1760" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Client as 🏢 Client\n    actor Expert as 👨‍💻 Expert\n    participant FE as React Frontend\n    participant JC as JobPostController\n    participant PC as ProposalController\n    participant PRC as ProjectController\n    participant DB as MySQL\n\n    Client-&gt;&gt;+FE: Create job post\n    FE-&gt;&gt;+JC: POST /api/jobs {title, budget}\n    JC-&gt;&gt;+DB: save JobPost{status=OPEN}\n    DB--&gt;&gt;-JC: JobPost\n    JC--&gt;&gt;-FE: JobPostResponse\n    FE--&gt;&gt;-Client: Job posted\n\n    Expert-&gt;&gt;+FE: Browse jobs → view detail\n    FE-&gt;&gt;+PC: GET /api/jobs/{id}/proposals\n    PC--&gt;&gt;-FE: ProposalList\n    FE--&gt;&gt;-Expert: Show proposals\n\n    Expert-&gt;&gt;+FE: Submit proposal\n    FE-&gt;&gt;+PC: POST /api/jobs/{id}/proposals\n    PC-&gt;&gt;+DB: save Proposal{status=PENDING}\n    DB--&gt;&gt;-PC: Proposal\n    PC--&gt;&gt;-FE: ProposalResponse\n    FE--&gt;&gt;-Expert: Proposal submitted\n\n    Client-&gt;&gt;+FE: View proposals\n    FE-&gt;&gt;+PC: GET /api/jobs/{id}/proposals\n    PC--&gt;&gt;-FE: ProposalList\n    FE--&gt;&gt;-Client: Show proposals list\n    Client-&gt;&gt;+FE: Accept a proposal\n    FE-&gt;&gt;+PC: PUT /api/proposals/{id}/accept\n    PC-&gt;&gt;+DB: Proposal{status=ACCEPTED}\n    DB--&gt;&gt;-PC: OK\n    PC-&gt;&gt;+DB: other Proposals{status=REJECTED}\n    DB--&gt;&gt;-PC: OK\n    PC--&gt;&gt;-FE: 200 OK\n    FE--&gt;&gt;-Client: Proposal accepted\n\n    Client-&gt;&gt;+FE: Confirm create project\n    FE-&gt;&gt;+PRC: POST /api/projects/proposal/{proposalId}\n    PRC-&gt;&gt;+DB: JobPost{status=IN_PROGRESS}\n    DB--&gt;&gt;-PRC: OK\n    PRC-&gt;&gt;+DB: save Project{status=ACTIVE}\n    DB--&gt;&gt;-PRC: Project\n    PRC--&gt;&gt;-FE: ProjectResponse\n    FE--&gt;&gt;-Client: Redirect to /projects/{id}&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lCrRU7iMGGIK8T2wCj79-105">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
