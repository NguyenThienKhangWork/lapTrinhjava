        <mxCell id="lCrRU7iMGGIK8T2wCj79-300" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;font: 700 20px / 30px quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(249, 250, 251); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(21, 21, 23); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Real-time Chat (WebSocket) Flow&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="100" width="350" x="2390" y="5840" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User as 👤 User\n    participant CB as AiChatbox Component\n    participant API as AiController\n    participant SVC as AiService\n    participant GEM as 🤖 Gemini API\n\n    User-&gt;&gt;+CB: Click FAB button 🤖\n    CB-&gt;&gt;CB: Open chat window\n    CB--&gt;&gt;-User: Welcome message + suggestions\n\n    User-&gt;&gt;+CB: Type question / click suggestion\n    CB-&gt;&gt;CB: Add user message to UI\n    CB-&gt;&gt;CB: Show typing animation ···\n    CB-&gt;&gt;+API: POST /api/ai/chat {message, history}\n    API-&gt;&gt;+SVC: chat(message, history)\n    SVC-&gt;&gt;+SVC: Build multi-turn prompt\n    SVC--&gt;&gt;-SVC: prompt\n    SVC-&gt;&gt;+GEM: POST generateContent {maxTokens:512}\n    Note over GEM: Xử lý ngôn ngữ&lt;br/&gt;~2-4 giây\n    GEM--&gt;&gt;-SVC: Vietnamese reply\n    SVC-&gt;&gt;+SVC: Strip thinking tags\n    SVC--&gt;&gt;-SVC: cleanedReply\n    SVC--&gt;&gt;-API: reply String\n    API--&gt;&gt;-CB: {reply: \&quot;...\&quot;}\n    CB-&gt;&gt;CB: Hide typing animation\n    CB-&gt;&gt;CB: Append to historyRef\n    CB--&gt;&gt;-User: Display AI response ✅&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lCrRU7iMGGIK8T2wCj79-301">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
