        <mxCell id="nCyYKYK0bvwXaZrJqaCw-93" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;font: 600 14px / 24px quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 12px 0px; color: rgb(207, 211, 214); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(21, 21, 23); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Full Project Lifecycle (Activity Diagram&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="530" y="4000" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    A([Start]) --&gt; B[Client browses Marketplace]\n    B --&gt; C{Expert used AI Generator?}\n    C --&gt;|Yes| D[AI generates description, process, SEO]\n    C --&gt;|No| E[Expert writes manually]\n    D --&gt; F[Publish ServiceListing]\n    E --&gt; F\n    F --&gt; G[Client selects a service]\n    G --&gt; H[Client orders: POST /projects/service/{id}]\n    H --&gt; I[Continue: Milestone → Escrow → Submit → Approve → Review]\n    I --&gt; J([End])&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nCyYKYK0bvwXaZrJqaCw-94">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
