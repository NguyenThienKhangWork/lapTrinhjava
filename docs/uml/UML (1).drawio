        <mxCell id="nCyYKYK0bvwXaZrJqaCw-115" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;font: 600 14px / 24px quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 12px 0px; color: rgb(207, 211, 214); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(21, 21, 23); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Marketplace (Direct Service Order) Activity Diagram&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="1360" y="1230" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    A([Start]) --&gt; B[Admin views PENDING disputes]\n    B --&gt; C[Admin reviews project details, claims, escrowed amount]\n    C --&gt; D{Decision}\n    D --&gt;|Refund to Client| E[Resolve: REFUND, Project → CANCELLED, Payment → REFUNDED, Client.balance += amount]\n    D --&gt;|Release to Expert| F[Resolve: RELEASE, Project → COMPLETED, Payment → RELEASED, Expert.balance += amount]\n    E --&gt; G([End])\n    F --&gt; G&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nCyYKYK0bvwXaZrJqaCw-116">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
