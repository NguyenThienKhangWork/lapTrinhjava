  <diagram id="bdqgKHHLuXxn8UdjtmE7" name="Page-5">
    <mxGraphModel dx="2060" dy="1124" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% ========== ENUMS ==========\n    class UserRole &lt;&lt;enum&gt;&gt; {\n        CLIENT\n        EXPERT\n        ADMIN\n    }\n\n    class JobStatus &lt;&lt;enum&gt;&gt; {\n        OPEN\n        IN_PROGRESS\n        COMPLETED\n        CANCELLED\n    }\n\n    class JobType &lt;&lt;enum&gt;&gt; {\n        PROJECT\n        SERVICE\n    }\n\n    class ProposalStatus &lt;&lt;enum&gt;&gt; {\n        PENDING\n        ACCEPTED\n        REJECTED\n    }\n\n    class ProjectStatus &lt;&lt;enum&gt;&gt; {\n        ACTIVE\n        COMPLETED\n        CANCELLED\n    }\n\n    class MilestoneStatus &lt;&lt;enum&gt;&gt; {\n        PENDING\n        SUBMITTED\n        APPROVED\n    }\n\n    class PaymentStatus &lt;&lt;enum&gt;&gt; {\n        PENDING\n        ESCROWED\n        RELEASED\n        REFUNDED\n    }\n\n    %% ========== TABLES ==========\n    class users &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        email : VARCHAR UNIQUE NOT NULL\n        password : VARCHAR NOT NULL\n        full_name : VARCHAR NOT NULL\n        role : UserRole NOT NULL\n        avatar : VARCHAR\n        bio : TEXT\n        skills : VARCHAR\n        certifications : TEXT\n        portfolio : TEXT\n        balance : DOUBLE\n        hourly_rate : DOUBLE\n        rating : DOUBLE\n        is_locked : BOOLEAN\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class job_posts &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        client_id : BIGINT FK NOT NULL\n        title : VARCHAR NOT NULL\n        description : TEXT NOT NULL\n        budget_min : DOUBLE\n        budget_max : DOUBLE\n        timeline : VARCHAR\n        skills_required : VARCHAR\n        status : JobStatus NOT NULL\n        type : JobType NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class services &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        expert_id : BIGINT FK NOT NULL\n        title : VARCHAR NOT NULL\n        description : TEXT NOT NULL\n        price : DOUBLE NOT NULL\n        delivery_time : VARCHAR NOT NULL\n        category : VARCHAR NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class proposals &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        job_post_id : BIGINT FK NOT NULL\n        expert_id : BIGINT FK NOT NULL\n        cover_letter : TEXT NOT NULL\n        proposed_budget : DOUBLE NOT NULL\n        proposed_timeline : VARCHAR NOT NULL\n        status : ProposalStatus NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class projects &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        job_post_id : BIGINT FK\n        service_id : BIGINT FK\n        client_id : BIGINT FK NOT NULL\n        expert_id : BIGINT FK NOT NULL\n        title : VARCHAR NOT NULL\n        status : ProjectStatus NOT NULL\n        start_date : DATETIME\n        end_date : DATETIME\n        total_amount : DOUBLE NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class milestones &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        project_id : BIGINT FK NOT NULL\n        title : VARCHAR NOT NULL\n        description : TEXT\n        deliverables : TEXT\n        feedback : TEXT\n        amount : DOUBLE NOT NULL\n        due_date : DATETIME\n        status : MilestoneStatus NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class payments &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        project_id : BIGINT FK NOT NULL\n        milestone_id : BIGINT FK\n        amount : DOUBLE NOT NULL\n        status : PaymentStatus NOT NULL\n        payment_method : VARCHAR\n        escrow_status : VARCHAR\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class messages &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        project_id : BIGINT FK NOT NULL\n        sender_id : BIGINT FK NOT NULL\n        content : TEXT NOT NULL\n        is_read : BOOLEAN NOT NULL\n        created_at : DATETIME\n    }\n\n    class notifications &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        user_id : BIGINT FK NOT NULL\n        title : VARCHAR NOT NULL\n        message : TEXT\n        notification_type : VARCHAR\n        reference_id : BIGINT\n        is_read : BOOLEAN\n        created_at : DATETIME\n    }\n\n    class reviews &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        project_id : BIGINT FK NOT NULL\n        reviewer_id : BIGINT FK NOT NULL\n        reviewee_id : BIGINT FK NOT NULL\n        rating : DOUBLE NOT NULL\n        comment : TEXT\n        created_at : DATETIME\n    }\n\n    class withdrawals &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        user_id : BIGINT FK NOT NULL\n        amount : DOUBLE NOT NULL\n        bank_name : VARCHAR NOT NULL\n        account_number : VARCHAR NOT NULL\n        account_holder_name : VARCHAR NOT NULL\n        status : VARCHAR NOT NULL\n        created_at : DATETIME\n        updated_at : DATETIME\n    }\n\n    class disputes &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        project_id : BIGINT NOT NULL\n        client_name : VARCHAR NOT NULL\n        expert_name : VARCHAR NOT NULL\n        title : VARCHAR NOT NULL\n        amount : DOUBLE NOT NULL\n        reason : TEXT NOT NULL\n        status : VARCHAR NOT NULL\n        created_at : DATETIME\n    }\n\n    class ai_modules &lt;&lt;table&gt;&gt; {\n        +id : BIGINT PK\n        name : VARCHAR UNIQUE NOT NULL\n        type : VARCHAR NOT NULL\n        config : TEXT\n        is_active : BOOLEAN NOT NULL\n    }\n\n    %% ========== RELATIONSHIPS ==========\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; job_posts : client_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; services : expert_id\n    job_posts \&quot;1\&quot; -- \&quot;0..*\&quot; proposals : job_post_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; proposals : expert_id\n    job_posts \&quot;0..1\&quot; -- \&quot;0..*\&quot; projects : job_post_id\n    services \&quot;0..1\&quot; -- \&quot;0..*\&quot; projects : service_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; projects : client_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; projects : expert_id\n    projects \&quot;1\&quot; -- \&quot;0..*\&quot; milestones : project_id\n    projects \&quot;1\&quot; -- \&quot;0..*\&quot; payments : project_id\n    milestones \&quot;0..1\&quot; -- \&quot;0..*\&quot; payments : milestone_id\n    projects \&quot;1\&quot; -- \&quot;0..*\&quot; messages : project_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; messages : sender_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; notifications : user_id\n    projects \&quot;1\&quot; -- \&quot;0..*\&quot; reviews : project_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; reviews : reviewer_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; reviews : reviewee_id\n    users \&quot;1\&quot; -- \&quot;0..*\&quot; withdrawals : user_id\n\n    %% ========== ENUM DEPENDENCIES ==========\n    users ..&gt; UserRole : role\n    job_posts ..&gt; JobStatus : status\n    job_posts ..&gt; JobType : type\n    proposals ..&gt; ProposalStatus : status\n    projects ..&gt; ProjectStatus : status\n    milestones ..&gt; MilestoneStatus : status\n    payments ..&gt; PaymentStatus : status\n\n    %% ========== NOTES ==========\n    note for disputes \&quot;project_id stored as plain Long (no FK constraint)\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8Z2ZtA6z2LFstg7nvl5e-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
