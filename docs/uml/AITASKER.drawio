        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Client as 🏢 Client\n    actor Expert as 👨‍💻 Expert\n    participant FE_C as React (Client)\n    participant FE_E as React (Expert)\n    participant WS as WebSocket/STOMP\n    participant CC as ChatController\n    participant DB as MySQL\n\n    FE_C-&gt;&gt;+WS: SockJS connect /ws\n    WS--&gt;&gt;-FE_C: Connected\n    FE_E-&gt;&gt;+WS: SockJS connect /ws\n    WS--&gt;&gt;-FE_E: Connected\n\n    FE_C-&gt;&gt;+WS: SUBSCRIBE /topic/project/{id}\n    WS--&gt;&gt;-FE_C: Subscribed\n    FE_E-&gt;&gt;+WS: SUBSCRIBE /topic/project/{id}\n    WS--&gt;&gt;-FE_E: Subscribed\n\n    Client-&gt;&gt;+FE_C: Type message → send\n    FE_C-&gt;&gt;+WS: SEND /app/chat/{projectId}\n    WS-&gt;&gt;+CC: handleMessage()\n    CC-&gt;&gt;+DB: save Message{isRead=false}\n    DB--&gt;&gt;-CC: Message\n    CC-&gt;&gt;+WS: BROADCAST /topic/project/{id}\n    WS--&gt;&gt;-FE_C: MessageResponse (echo)\n    WS--&gt;&gt;-FE_E: MessageResponse ⚡\n    FE_C--&gt;&gt;-Client: Message sent\n    FE_E--&gt;&gt;-Expert: New message received\n\n    alt WebSocket fails (fallback)\n        FE_C-&gt;&gt;+CC: POST /api/messages/{projectId}\n        CC-&gt;&gt;+DB: save Message\n        DB--&gt;&gt;-CC: Message\n        CC--&gt;&gt;-FE_C: MessageResponse\n        FE_C--&gt;&gt;-Client: Message sent (REST fallback)\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lCrRU7iMGGIK8T2wCj79-250">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
