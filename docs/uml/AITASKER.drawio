        <mxCell id="lCrRU7iMGGIK8T2wCj79-174" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h3 style=&quot;font: 700 20px / 30px quote-cjk-patch, Inter, system-ui, -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, Cantarell, &amp;quot;Open Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; margin: 32px 0px 16px; color: rgb(249, 250, 251); letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(21, 21, 23); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span class=&quot;&quot;&gt;Job Post → Project Creation Flow (có&lt;span&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;code style=&quot;box-sizing: border-box; font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-family: Menlo, Monaco, Consolas, &amp;quot;Cascadia Mono&amp;quot;, &amp;quot;Ubuntu Mono&amp;quot;, &amp;quot;DejaVu Sans Mono&amp;quot;, &amp;quot;Liberation Mono&amp;quot;, &amp;quot;JetBrains Mono&amp;quot;, &amp;quot;Fira Code&amp;quot;, Cousine, &amp;quot;Roboto Mono&amp;quot;, &amp;quot;Courier New&amp;quot;, Courier, sans-serif, system-ui; background-color: rgb(44, 44, 46); border-radius: 6px; align-items: center; padding: 0px 5px; display: inline-flex; font-size: inherit;&quot;&gt;alt&lt;/code&gt;&lt;span class=&quot;&quot;&gt;&lt;span&gt;&amp;nbsp;&lt;/span&gt;khi chọn Proposal)&lt;/span&gt;&lt;/h3&gt;" vertex="1">
          <mxGeometry height="130" width="560" x="2270" y="4150" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Client as 🏢 Client\n    actor Expert as 👨‍💻 Expert\n    participant FE as React ProjectDetail\n    participant MC as MilestoneController\n    participant PAY as PaymentController\n    participant SVC as PaymentService\n    participant DB as MySQL\n\n    Client-&gt;&gt;+FE: Create milestone\n    FE-&gt;&gt;+MC: POST /api/projects/{id}/milestones\n    MC-&gt;&gt;+DB: save Milestone{status=PENDING}\n    DB--&gt;&gt;-MC: Milestone\n    MC--&gt;&gt;-FE: MilestoneResponse\n    FE--&gt;&gt;-Client: Milestone created\n\n    Client-&gt;&gt;+FE: Fund escrow\n    FE-&gt;&gt;+PAY: POST /api/payments {projectId, milestoneId}\n    PAY-&gt;&gt;+SVC: createEscrowPayment()\n    SVC-&gt;&gt;+DB: save Payment{status=ESCROWED}\n    DB--&gt;&gt;-SVC: Payment\n    SVC--&gt;&gt;-PAY: PaymentResponse\n    PAY--&gt;&gt;-FE: 201 Created ✅\n    FE--&gt;&gt;-Client: Escrow funded\n\n    Expert-&gt;&gt;+FE: Submit deliverables\n    FE-&gt;&gt;+MC: PUT /api/milestones/{id}/submit\n    MC-&gt;&gt;+DB: Milestone{status=SUBMITTED}\n    DB--&gt;&gt;-MC: OK\n    MC--&gt;&gt;-FE: MilestoneResponse\n    FE--&gt;&gt;-Expert: Deliverables submitted\n\n    Client-&gt;&gt;+FE: Approve milestone\n    FE-&gt;&gt;+MC: PUT /api/milestones/{id}/approve\n    MC-&gt;&gt;+SVC: approveMilestone()\n    SVC-&gt;&gt;+DB: Milestone{status=APPROVED}\n    DB--&gt;&gt;-SVC: OK\n    SVC-&gt;&gt;+DB: Payment{status=RELEASED}\n    DB--&gt;&gt;-SVC: OK\n    SVC-&gt;&gt;+DB: Expert.balance += amount\n    DB--&gt;&gt;-SVC: OK\n    SVC--&gt;&gt;-MC: Success\n    MC--&gt;&gt;-FE: MilestoneResponse\n    FE--&gt;&gt;-Client: Approved &amp; paid\n    FE--&gt;&gt;-Expert: Balance updated 💰\n\n    Client-&gt;&gt;+FE: Complete project\n    FE-&gt;&gt;+MC: PUT /api/projects/{id}/complete\n    MC-&gt;&gt;+DB: Project{status=COMPLETED}\n    DB--&gt;&gt;-MC: OK\n    MC--&gt;&gt;-FE: 200 OK\n    FE--&gt;&gt;-Client: Project completed&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lCrRU7iMGGIK8T2wCj79-175">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="🏢 Client" mermaidId="n:Client" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="🏢 Client" id="lCrRU7iMGGIK8T2wCj79-176">
          <mxCell parent="lCrRU7iMGGIK8T2wCj79-175" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
